--!strict

--[[
	Central client type module: types used across client module boundaries live here, so a module
	can annotate a lazily-required singleton (the cycle-breaking `local x` assigned inside init())
	without a module-scope require of the module that implements it. Types.luau must never require
	another client module.

	Two sections:
	- HAND-MAINTAINED (top): interface types for classes whose instances cross module boundaries
	  (TargetBase, CustomProximityPrompt, ...) and shared protocols (Overlay, OverlayNotifier).
	- GENERATED (below the marker): consumer interfaces for the lazily-required singletons,
	  derived from their annotated definitions by tools/generate_types.py. The lazy requires still
	  return untyped-through-annotation values, so these are a promise kept in sync by
	  regenerating after signature changes, not something the solver checks.
]]

-- protocol implemented by every exclusive full-screen overlay (stores, trading, options, ...);
-- OverlayTracker drives it and forwards it to the registered OverlayNotifiers.
-- The do* hooks are optional: OverlayTracker checks for their presence before calling.
export type Overlay = {
	getGuiRoot: (self: Overlay) -> Instance,
	getHudElements: (self: Overlay) -> { number },
	notifyForceEnd: (self: Overlay) -> (),
	notifyClickOutside: (self: Overlay) -> (),
	doesWantBlur: ((self: Overlay) -> boolean)?,
	doAllowPlayerWorldActions: ((self: Overlay) -> boolean)?,
	doZoomCamera: ((self: Overlay) -> boolean)?,
	doAllowStoreAutoOpen: ((self: Overlay) -> boolean)?,
}

-- ClientShadowManager: map of part name, to second part name, to distance between those two
-- parts, for every pair of parts connected by a ball-socket constraint
export type PartMap = { [string]: { [string]: number } }

-- observer registered with OverlayTracker:addOverlayNotifier()
export type OverlayNotifier = {
	notifyBeginOverlay: (self: OverlayNotifier, overlay: Overlay, hudElements: { number }) -> (),
	notifyEndOverlay: (self: OverlayNotifier, overlay: Overlay, hudElements: { number }) -> (),
}

